# Oraya Web — environment variable names with placeholder values only (NO REAL SECRETS).
# Copy to `.env.local`, replace each `replace_with_*` placeholder with the real value, and never commit `.env.local`.
# Vercel Production/Preview env is configured separately in the Vercel dashboard — mirror keys there as needed.
# Full per-variable docs: docs/system/ENVIRONMENT_MAP.md
# See README.md for local testing notes.

# --- Supabase (browser + server) ---
# From: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=replace_with_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_anon_public_key

# Server-only: required for admin APIs, media, pricing, bookings server paths, cron sync, etc.
# Without this key, `supabase-admin` routes fail locally with errors like "supabaseKey is required".
# From: Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# --- Resend (transactional email) ---
# From: resend.com → Dashboard → API Keys
# Note: the Resend "from" address is intentionally hardcoded as `FROM_EMAIL` in
# each lib/send-*-email.ts. No env var overrides it today — see
# docs/system/DECISIONS_LOG.md (2026-05-09 entry on the hardcoded sender).
RESEND_API_KEY=replace_with_resend_api_key

# --- URLs ---
# Absolute site base for links in emails and booking flows (falls back to lib/brand SITE_URL if unset).
# Local: http://localhost:3000 for general app testing.
# CyberSource Unified Checkout requires an HTTPS origin for real browser payment testing; use Vercel Preview,
# production, or a local HTTPS tunnel for sandbox checkout UI validation.
# Preview: the Vercel preview URL — Production: https://stayoraya.com
NEXT_PUBLIC_SITE_URL=replace_with_site_origin_url

# --- Auth & automation (server-only) ---
# Generate strong randoms (≥32 bytes), e.g. `openssl rand -base64 32`. Use a DIFFERENT value for each.

# HMAC secret for signing/verifying booking action + view tokens (lib/booking-action-token.ts). No fallback.
BOOKING_ACTION_SECRET=replace_with_random_32_byte_secret

# Bearer token Vercel Cron uses to authorize GET /api/cron/calendar-sync. No fallback.
CRON_SECRET=replace_with_random_32_byte_secret

# HMAC key for the signed admin session cookie + bearer fallback for /api/admin/*. No fallback.
ADMIN_SECRET=replace_with_random_32_byte_secret

# --- Phase 16A / 16B server-side integrations ---
# Shared secret for /api/butler/* secret-guarded endpoints.
# Generate: `openssl rand -base64 32`. Distinct from BOOKING_ACTION_SECRET / CRON_SECRET / ADMIN_SECRET.
BUTLER_WEBHOOK_SECRET=replace_with_butler_webhook_secret

# HMAC secret for short-lived WhatsApp -> /book prefill handoff tokens.
# Used only by lib/butler/prefill-token.ts and /api/butler/prefill.
BUTLER_PREFILL_SECRET=replace_with_butler_prefill_secret

# Hosted payment provider selector for /api/payments/checkout.
# Production must use `credit_libanais`. `stripe` is for local/dev test only.
PAYMENT_PROVIDER=credit_libanais

# Credit Libanais / NetCommerce / CyberSource Unified Checkout placeholders.
# Server-only. Use sandbox values in local/preview; use production values only after bank confirmation.
NETCOMMERCE_CYBERSOURCE_ENVIRONMENT=sandbox
NETCOMMERCE_CYBERSOURCE_MERCHANT_ID=replace_with_netcommerce_cybersource_merchant_id
NETCOMMERCE_CYBERSOURCE_KEY_ID=replace_with_netcommerce_cybersource_key_id
NETCOMMERCE_CYBERSOURCE_SHARED_SECRET=replace_with_netcommerce_cybersource_shared_secret
NETCOMMERCE_CYBERSOURCE_API_BASE_URL=replace_with_netcommerce_cybersource_api_base_url
NETCOMMERCE_CYBERSOURCE_COUNTRY=LB
NETCOMMERCE_CYBERSOURCE_LOCALE=en_US

# CyberSource Payments API JWT + message-level encryption (MLE).
# Paste PEM values as multiline secrets in Vercel; literal \\n separators are also accepted.
NETCOMMERCE_CYBERSOURCE_REQUEST_MLE_CERTIFICATE=replace_with_cybersource_sjc_public_certificate_pem
NETCOMMERCE_CYBERSOURCE_REQUEST_MLE_KEY_ID=replace_with_cybersource_sjc_certificate_serial_number
NETCOMMERCE_CYBERSOURCE_RESPONSE_MLE_KEY_ID=replace_with_rest_api_response_mle_key_id
NETCOMMERCE_CYBERSOURCE_RESPONSE_MLE_PRIVATE_KEY=replace_with_rest_api_response_mle_pkcs8_private_key_pem

# Required for asynchronous webhook reconciliation and production hardening.
# Browser redirects are informational; server-side gateway verification and/or verified webhooks are authoritative.
NETCOMMERCE_CYBERSOURCE_WEBHOOK_MLE_KEY_ID=replace_with_netcommerce_cybersource_webhook_mle_key_id
NETCOMMERCE_CYBERSOURCE_WEBHOOK_MLE_PRIVATE_KEY=replace_with_netcommerce_cybersource_webhook_mle_private_key
NETCOMMERCE_CYBERSOURCE_WEBHOOK_MLE_CERTIFICATE_ID=replace_with_netcommerce_cybersource_webhook_mle_certificate_id
NETCOMMERCE_CYBERSOURCE_WEBHOOK_SIGNATURE_KEY_ID=replace_with_netcommerce_cybersource_webhook_digital_signature_key_id
NETCOMMERCE_CYBERSOURCE_WEBHOOK_SIGNATURE_SECRET=replace_with_netcommerce_cybersource_webhook_base64_digital_signature_secret

# Exact opt-in only after CyberSource/NetCommerce Apple Pay enrollment, a
# successful device test, and verification of the host that actually serves
# checkout (currently www.stayoraya.com after the bare-domain redirect).
NETCOMMERCE_CYBERSOURCE_APPLE_PAY_ENABLED=false

# Phase 16C — automatic WhatsApp Arrival Guide dispatch (all server-only, all optional).
# WHATCHIMP_CONFIRMED_STAY_WEBHOOK_URL is the activation switch: while unset, no outbound
# call is ever made (fail closed). Set it in Vercel PRODUCTION only after Meta approves the
# oraya_arrival_guide_confirmed template and the WhatChimp Webhook Workflow exists.
# The secret is optional (sent as X-Oraya-Webhook-Secret only when set). The ALLOW_NONPROD
# flag must stay unset except during a supervised Preview test against a disposable workflow.
WHATCHIMP_CONFIRMED_STAY_WEBHOOK_URL=
WHATCHIMP_CONFIRMED_STAY_WEBHOOK_SECRET=
WHATSAPP_CONFIRMATION_ALLOW_NONPROD=

# --- Phase 16D Stage A — access-PIN vault (server-only, DARK, no runtime consumer yet) ---
# Dedicated secrets for the door-PIN magazine (lib/access/pin-vault.ts +
# sql/phase-16d-access-magazine.sql). Deliberately NOT derived from ADMIN_SECRET or any
# other existing secret. Leave unset until Phase 16D Stage B is approved — nothing reads
# them today, and the vault fails closed while they are missing/malformed.
# ACCESS_PIN_VAULT_KEYS: ordered keyring "k1:<base64-32-bytes>[,k2:<base64-32-bytes>...]";
# FIRST entry encrypts, every entry decrypts. Rotate by PREPENDING a new key and keeping
# old entries until no live credential's envelope references them. Generate each key with
# `openssl rand -base64 32`. Losing every referenced key makes active credentials
# unrecoverable (quarantine -> dual-lock deletion -> destroy -> reload is the only remedy).
ACCESS_PIN_VAULT_KEYS=
# ACCESS_PIN_FINGERPRINT_KEY: separate stable HMAC key for historical duplicate
# prevention. Must differ from every vault key and should effectively never rotate
# (rotation breaks duplicate detection against historical fingerprints).
ACCESS_PIN_FINGERPRINT_KEY=

# Optional Stripe local/dev test credentials only. Not for Oraya production.
STRIPE_SECRET_KEY=replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=replace_with_stripe_publishable_key
