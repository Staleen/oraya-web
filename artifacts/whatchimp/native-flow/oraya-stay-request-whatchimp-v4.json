{
  "version": "7.3",
  "screens": [
    {
      "id": "STAY_DETAILS",
      "title": "Request a private stay",
      "terminal": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "stay_form",
            "children": [
              {
                "type": "Image",
                "src": "",
                "height": 140,
                "scale-type": "cover"
              },
              {
                "type": "TextSubheading",
                "text": "Request a private stay"
              },
              {
                "type": "TextBody",
                "text": "Share your stay details. You'll receive a secure link right away to continue your booking on our website."
              },
              {
                "type": "TextInput",
                "required": true,
                "label": "Full name",
                "name": "oraya_full_name",
                "input-type": "text"
              },
              {
                "type": "DatePicker",
                "required": true,
                "label": "Check-in",
                "name": "normalized_check_in"
              },
              {
                "type": "DatePicker",
                "required": true,
                "label": "Check-out",
                "name": "normalized_check_out"
              },
              {
                "type": "RadioButtonsGroup",
                "label": "Villa",
                "required": true,
                "name": "oraya_villa",
                "data-source": [
                  {
                    "id": "Villa Mechmech",
                    "title": "Villa Mechmech"
                  },
                  {
                    "id": "Villa Byblos",
                    "title": "Villa Byblos"
                  },
                  {
                    "id": "flexible",
                    "title": "Flexible"
                  }
                ]
              },
              {
                "type": "Dropdown",
                "label": "Overnight guests",
                "required": true,
                "name": "oraya_guest_count",
                "data-source": [
                  {
                    "id": "1",
                    "title": "1 guest"
                  },
                  {
                    "id": "2",
                    "title": "2 guests"
                  },
                  {
                    "id": "3",
                    "title": "3 guests"
                  },
                  {
                    "id": "4",
                    "title": "4 guests"
                  },
                  {
                    "id": "5",
                    "title": "5 guests"
                  },
                  {
                    "id": "6",
                    "title": "6 guests"
                  },
                  {
                    "id": "7",
                    "title": "7 guests"
                  },
                  {
                    "id": "8",
                    "title": "8 guests"
                  },
                  {
                    "id": "more_than_8",
                    "title": "More than 8 guests"
                  }
                ]
              },
              {
                "type": "RadioButtonsGroup",
                "label": "Bedrooms to prepare",
                "required": true,
                "name": "oraya_bedroom_count",
                "data-source": [
                  {
                    "id": "1",
                    "title": "1 bedroom"
                  },
                  {
                    "id": "2",
                    "title": "2 bedrooms"
                  },
                  {
                    "id": "3",
                    "title": "3 bedrooms"
                  }
                ]
              },
              {
                "type": "TextArea",
                "label": "Special requests",
                "required": false,
                "name": "oraya_special_requests"
              },
              {
                "type": "TextBody",
                "text": "Submitting sends a stay request, not a confirmed booking. Your secure booking link will arrive in this chat right after you submit."
              },
              {
                "type": "Footer",
                "label": "Submit stay details",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "oraya_full_name": "${form.oraya_full_name}",
                    "normalized_check_in": "${form.normalized_check_in}",
                    "normalized_check_out": "${form.normalized_check_out}",
                    "oraya_villa": "${form.oraya_villa}",
                    "oraya_guest_count": "${form.oraya_guest_count}",
                    "oraya_bedroom_count": "${form.oraya_bedroom_count}",
                    "oraya_special_requests": "${form.oraya_special_requests}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}